{
  "rule": "A session whose last user entry is a user interrupt ([Request interrupted by user...]) has outcome interrupted; a later prompt makes it ok again. Interrupt markers are not prompts or turns.",
  "dirs": [
    "Projects/garden"
  ],
  "files": {
    ".claude/projects/-garden/s-stopped.jsonl": [
      {
        "type": "user",
        "cwd": "{{HOME}}/Projects/garden",
        "gitBranch": "main",
        "timestamp": "2026-10-01T12:00:00.000Z",
        "message": {
          "role": "user",
          "content": "mow the lawn"
        }
      },
      {
        "type": "assistant",
        "cwd": "{{HOME}}/Projects/garden",
        "timestamp": "2026-10-01T12:01:00.000Z",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "tool_use",
              "id": "t1",
              "name": "Bash",
              "input": {
                "command": "ls"
              }
            }
          ]
        }
      },
      {
        "type": "user",
        "cwd": "{{HOME}}/Projects/garden",
        "gitBranch": "main",
        "timestamp": "2026-10-01T12:02:00.000Z",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "tool_result",
              "tool_use_id": "t1",
              "content": "ok"
            }
          ]
        }
      },
      {
        "type": "user",
        "cwd": "{{HOME}}/Projects/garden",
        "gitBranch": "main",
        "timestamp": "2026-10-01T12:03:00.000Z",
        "message": {
          "role": "user",
          "content": [
            {
              "type": "text",

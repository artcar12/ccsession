            }
          ]
        }
      }
    ],
    ".claude/projects/-garden/s-resumed.jsonl": [
      {
        "type": "user",
        "cwd": "{{HOME}}/Projects/garden",
        "gitBranch": "main",
        "timestamp": "2026-10-01T12:00:00.000Z",
        "message": {
          "role": "user",
          "content": "rake the leaves"
        }
      },
      {
        "type": "user",
        "cwd": "{{HOME}}/Projects/garden",

        "message": {
          "role": "user",
          "content": "[Request interrupted by user]"
        }
      },
      {
        "type": "user",
        "cwd": "{{HOME}}/Projects/garden",
        "gitBranch": "main",
        "timestamp": "2026-10-01T12:02:00.000Z",
        "message": {
          "role": "user",
          "content": "rake the front only"
        }
      },
      {
        "type": "assistant",
        "cwd": "{{HOME}}/Projects/garden",
        "timestamp": "2026-10-01T12:03:00.000Z",
        "message": {
          "role": "assistant",
          "content": [
            {
              "type": "text",
              "text": "Raked."
            }
          ]
        }
      }
    ]
  },
  "expect": {
    "live": {},
    "sessions": {
      "s-stopped": {
        "outcome": "interrupted",
        "turns": 1,
        "last_prompt": "mow the lawn",
